# Generated Xcode project (regenerated by `make project`)
*.xcodeproj/

# Build output
build/
build-release/
DerivedData/
.build/
Packages/*/.build/
Packages/*/.swiftpm/
*.xcworkspace
*.xcuserdata

# Coverage / profiling artifacts
default.profraw
*.profdata

# Distribution
Mila-*.dmg

# Generated diarization Python runtime bundle (built by scripts/build-diarization-bundle.sh,
# distributed via GitHub release asset; do NOT commit ~150 MB into git).
# No trailing slash on purpose: in a git worktree this path is often a *symlink*
# back to the main checkout, and a trailing-slash pattern matches directories only.
Mila/Resources/PythonRuntime

# macOS
.DS_Store

# Editor
.vscode/
.idea/

# Slack emoji asset generated by hand; not part of the app bundle
Mila-slack-emoji.png
__pycache__/
*.pyc

# Local-only LLM implementation plans / scratch artifacts
llm-artifacts/
